# Credentials
.env
*.env
.env.*

# Personal email data (inbox content — never commit)
raw_email/
raw_email_text/
email_pipeline/email_text/*.txt
email_pipeline/email_text/*.meta.json
email_pipeline/logs/
email_pipeline/structured_outputs/email/
email_pipeline/normalized_outputs/

# Pipeline generated outputs (large, regenerated locally)
# .gitkeep files are committed so directories survive git clean
raw_text/*
!raw_text/.gitkeep
raw_html/*
!raw_html/.gitkeep
structured_outputs/*
!structured_outputs/.gitkeep
normalized_outputs/*
!normalized_outputs/.gitkeep
logs/*
!logs/.gitkeep
merged_promotions.json
all_promotions.json
brand_locations.json
logos/
locations/

# Local test/cache output
.pytest_cache/
.pytest-basetemp/
.tmp/
__pycache__/
*.pyc
